# Caminho do Android SDK (obrigatório para o Appium / UiAutomator2)
# Ex.: C:\Users\<seu-usuario>\AppData\Local\Android\Sdk
ANDROID_HOME=C:\Users\cliente\AppData\Local\Android\Sdk
ANDROID_SDK_ROOT=C:\Users\cliente\AppData\Local\Android\Sdk

# Java JDK 17+ (obrigatório para Appium / UiAutomator2)
# Pasta do JDK, SEM \bin no final.
# Ex.: C:\Program Files\Microsoft\jdk-17.0.20.8-hotspot
JAVA_HOME=C:\Program Files\Microsoft\jdk-17.0.20.8-hotspot

# Galaxy S23 físico via USB. Este repo não sobe emulador.
ANDROID_DEVICE_NAME=Galaxy_S23
ANDROID_PLATFORM_VERSION=16
# Serial de `adb devices` (status precisa ser device, não unauthorized)
ANDROID_UDID=

APPIUM_PORT=4723

# true reinstala o APK a cada teste (mais isolado, bem mais lento). Padrão: false.
RESET_BETWEEN_TESTS=false

# off (padrão, mais rápido) | on-failure (screenshot + XML só para investigar)
TAQWRIGHT_TRACE=off

# Abrir o HTML nativo do Playwright ao fim (Taqwright: npx taqwright show-report)
# O Allure continua opcional via npm run report:allure:full
ALLURE_OPEN=true
